# Byte-compiled files and Python caches
__pycache__/
*.py[cod]
*$py.class

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test, coverage, and tool caches
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# Generated project output
**/figures/*
!**/figures/.gitkeep
**/outputs/*
!**/outputs/.gitkeep

# Local configuration and secrets
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*~
*.swp
